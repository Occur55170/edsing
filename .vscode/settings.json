{
  "editor.tabSize": 2,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit",
    "source.fixAll.markdownlint": "explicit"
  },
  "[markdown]": {
    "editor.formatOnSave": true
    // "editor.formatOnPaste": true
  },
  "stylelint.validate": ["css", "scss", "vue"],
  "files.eol": "\n",
  "files.exclude": {
    "**/.git": false
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": true
  },
  "cSpell.words": [
    "amphtml",
    "camelcase",
    "Casified",
    "Casify",
    "composables",
    "dayjs",
    "fantasticon",
    "FEEDLY",
    "googletag",
    "itemprop",
    "Jsonld",
    "lastmod",
    "longform",
    "nitropack",
    "nuxt",
    "Nuxt",
    "nuxtjs",
    "ofetch",
    "ohmyfetch",
    "Paids",
    "pinia",
    "pubdate",
    "Roboto",
    "Segoe",
    "sehseh",
    "signin",
    "Signout",
    "stylelint",
    "swiper",
    "tailwindcss",
    "thirdparty",
    "tiktok",
    "TIKTOK",
    "vetur",
    "vitepress",
    "vuejs",
    "vueuse",
    "Vuex",
    "vvip",
    "VVIP",
    "weibo",
    "xstate",
    "youtube",
    "YOUTUBE"
  ],
  "css.validate": false,
  "scss.validate": false
}
